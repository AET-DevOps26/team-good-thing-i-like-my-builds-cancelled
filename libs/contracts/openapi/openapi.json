{
    "openapi": "3.1.0",
    "info": {
        "title": "OpenAPI definition",
        "version": "v0"
    },
    "servers": [
        {
            "url": "http://localhost:9100",
            "description": "Generated server url (route-service)"
        },
        {
            "url": "http://localhost:9200",
            "description": "Generated server url (genai-service)"
        }
    ],
    "paths": {
        "/api/v1/examples": {
            "get": {
                "tags": [
                    "Examples"
                ],
                "summary": "Get all examples",
                "operationId": "getExamples",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ExampleDto"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Examples"
                ],
                "summary": "Create a new example",
                "operationId": "save",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ExampleCreateRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ExampleDto"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/examples/{exampleId}": {
            "get": {
                "tags": [
                    "Examples"
                ],
                "summary": "Get an example by id",
                "operationId": "getExample",
                "parameters": [
                    {
                        "name": "exampleId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ExampleDto"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/ai/generate-report": {
            "get": {
                "tags": [
                    "AI"
                ],
                "summary": "Generate a travel report",
                "operationId": "generateReport",
                "parameters": [
                    {
                        "name": "description",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Report generated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "report": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/ai/recommend-destinations": {
            "get": {
                "tags": [
                    "AI"
                ],
                "summary": "Recommend destinations",
                "operationId": "recommendDestinations",
                "parameters": [
                    {
                        "name": "visited",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Recommendations",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "recommendations": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ExampleCreateRequest": {
                "type": "object",
                "description": "Create example request payload",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Example name",
                        "minLength": 1
                    }
                },
                "required": [
                    "name"
                ]
            },
            "ExampleDto": {
                "type": "object",
                "description": "Example response payload",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Example identifier"
                    },
                    "name": {
                        "type": "string",
                        "description": "Example name"
                    }
                }
            }
        }
    }
}
