{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "openapi:fetch": "curl -fsSL http://localhost:9100/v3/api-docs -o ../../libs/contracts/openapi/openapi.json",
    "openapi:generate": "npx --yes @openapitools/openapi-generator-cli generate -i ../../libs/contracts/openapi/openapi.json -g typescript-angular -o ../../libs/contracts/openapi/src/lib/generated -c openapi-generator.config.json",
    "openapi:sync": "npm run openapi:fetch && npm run openapi:generate",
    "serve:ssr:client": "node dist/client/server/server.mjs",
    "test:test": "ng test",
    "test:lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.10",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.10",
    "@angular/cli": "^21.2.10",
    "@angular/compiler-cli": "^21.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
