<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <Match>
    <Package name="~dev\.gtilmbc\.logbookservice\.generated(\..*)?"/>
  </Match>
  <!-- Controllers use injected services with @RequiredArgsConstructor, this is fine -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Class name="~.*Controller"/>
  </Match>
</FindBugsFilter>
