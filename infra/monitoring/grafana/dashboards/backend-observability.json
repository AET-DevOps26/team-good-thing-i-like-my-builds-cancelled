{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"logbook-service|route-service\"}[5m])) by (job) or label_replace(sum(rate(app_http_requests_total{service=\"genai-service\"}[5m])) by (service), \"job\", \"$1\", \"service\", \"(.*)\")",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "Error Ratio (5xx)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(sum(rate(http_server_requests_seconds_count{job=~\"logbook-service|route-service\",status=~\"5..\"}[5m])) by (job) / clamp_min(sum(rate(http_server_requests_seconds_count{job=~\"logbook-service|route-service\"}[5m])) by (job), 0.0001)) or label_replace((sum(rate(app_http_request_errors_total{service=\"genai-service\"}[5m])) by (service) / clamp_min(sum(rate(app_http_requests_total{service=\"genai-service\"}[5m])) by (service), 0.0001)), \"job\", \"$1\", \"service\", \"(.*)\")",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "P95 Latency (s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_requests_seconds_bucket{job=~\"logbook-service|route-service\"}[5m]))) or label_replace(histogram_quantile(0.95, sum by (le, service) (rate(app_http_request_duration_seconds_bucket{service=\"genai-service\"}[5m]))), \"job\", \"$1\", \"service\", \"(.*)\")",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "title": "Target Availability",
      "type": "timeseries",
      "targets": [
        {
          "expr": "up{job=~\"logbook-service|route-service|genai-service\"}",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "observability",
    "prometheus",
    "backend"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Backend Observability",
  "uid": "backend-observability",
  "version": 1,
  "weekStart": ""
}
